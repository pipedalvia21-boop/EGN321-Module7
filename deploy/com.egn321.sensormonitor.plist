<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS LaunchAgent. Installed by deploy/install_macos.sh, which fills in the paths.
     RunAtLoad starts it at login; KeepAlive restarts the supervisor whenever it stops. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.egn321.sensormonitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__PROJECT_DIR__/supervisor.py</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/logs/launchd.stderr.log</string>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/logs/launchd.stdout.log</string>
</dict>
</plist>
